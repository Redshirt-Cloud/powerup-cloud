{
  "name": "powerup-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.json",
    "deploy": "wrangler deploy --config wrangler.deploy.json",
    "prepare:deploy": "node scripts/prepare-deploy-config.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22"
  }
}
