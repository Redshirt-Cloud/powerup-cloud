{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "powerup-cloud-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "powerup-cloud",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
